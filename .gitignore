# Terraform working directory (providers, modules)
.terraform/

# State files contain resource details and sometimes secrets
*.tfstate
*.tfstate.*

# Saved plans
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files often hold personal values; commit *.tfvars.example instead
*.tfvars
*.tfvars.json

# Exception: project 08's per-environment settings. Address ranges only, no secrets,
# and the pipeline needs them.
!08-environments/envs/*.tfvars

# Commit .terraform.lock.hcl: it pins provider versions for everyone
